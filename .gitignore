# ==============================================================================
# .gitignore — Жеке мәліметтер мен құпиялардың GitHub-қа кетпеуін қамтамасыз етеді
# ==============================================================================

# 1. Құпиялар, токендер, кілттер және парольдер (ҚАТАҢ ТЫЙЫМ САЛЫНАДЫ)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
credentials.json
service-account*.json

# 2. Деректер қорының дамптары және жеке ақпараттар (PII & DB Dumps)
*.sql
*.dump
*.tar
*.bak
*.sqlite
*.sqlite3
data/
dumps/
backups/

# 3. Docker және жергілікті контейнер томдары (Local Volumes)
postgres_data/
redis_data/
rabbitmq_data/
ollama_data/
keycloak_data/

# 4. Python виртуалды ортасы және кэштер
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 5. Node.js & Next.js 16 (web/) фронтенд файлдары
node_modules/
web/node_modules/
.next/
web/.next/
out/
web/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Журналдар мен логтар (Logs)
*.log
logs/

# 7. Операциялық жүйе мен IDE файлдары
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
