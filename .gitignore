# --- Python ---
# Құпиялар мен коннектинг деректері — репозиторийге түспейді
.env
# Виртуалды орта — python -m venv .venv арқылы қайта жасалады
.venv/
# Python bytecode кэш папкасы
__pycache__/
# Компиляцияланған Python файлдары
*.pyc

# --- Node / Next.js ---
# Node.js тәуелділіктері — npm install арқылы қайта орнатылады
node_modules/
# Next.js құрастыру кэш папкасы
.next/

# --- Логу ---
# Қолданба журналдары — тарихта сақталмайды
*.log
