# ==============================================================================
# Қоршаған орта үлгісі (.env.example)
# Нақты құпия мәндерді .env файлына енгізіңіз (ол .gitignore-да)
# ==============================================================================

# Project
PROJECT_NAME="AIDD Platform"
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_secure_random_key

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_secure_password
DATABASE_URL=postgresql+asyncpg://app_user:app_secure_password@postgres:5432/app_db

# Keycloak (OIDC)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=aidd-realm
KEYCLOAK_CLIENT_ID=aidd-backend
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password
# Keycloak-тың өз дерекқоры (app_db-дан бөлек — 8-сабақ)
KEYCLOAK_DB=keycloak_db

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=aidd_tasks

# Web & CORS
FRONTEND_URL=http://localhost:3000
